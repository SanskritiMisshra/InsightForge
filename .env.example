# ==============================================================================
# InsightForge — Environment Configuration Template (.env.example)
# Authoritative for deployment configurations
# ==============================================================================

# Network & Server Port (Strict Invariant: Port 8080 ONLY; Port 3000 is strictly prohibited)
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production

# Persistence & Storage (Isolate data on high-capacity drive or mounted volume)
DB_PATH=d:\InsightForge\data\insightforge.db
DATA_DIR=d:\InsightForge\data

# Cryptographic & Security Configuration
# Generate secure secret via: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace_with_cryptographically_secure_random_hex_string
SESSION_EXPIRY_DAYS=7
COOKIE_SECURE=false # Set to true in HTTPS production deployments
COOKIE_SAMESITE=lax

# DuckDB Sandbox Invariants & Resource Guardrails
DUCKDB_MAX_MEMORY=4GB
DUCKDB_THREADS=4
DUCKDB_QUERY_TIMEOUT_SECONDS=10

# Export & Deliverable Configuration
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=csv,xlsx,parquet

# Logging
LOG_LEVEL=INFO
